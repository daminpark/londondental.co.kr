---
import { getEntry, render } from 'astro:content';
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';

const entry = await getEntry('pages', 'ko/faq');
const { Content } = await render(entry!);
---

<MarkdownLayout title={entry!.data.title} description={entry!.data.description} lang="ko" canonicalPath="/ko/faq">
  <Content />
</MarkdownLayout>
