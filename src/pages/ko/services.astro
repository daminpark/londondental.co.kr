---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { clinic } from '../../data/clinic';

const lang = 'ko' as const;

const services = [
  {
    title: '심미 치과 & 치아 미백',
    desc: '전문 미백, 라미네이트(비니어), 심미 본딩, 스마일 메이크오버로 밝고 자신감 있는 미소를 되찾으세요.',
    slug: 'cosmetic',
    icon: '/images/icons/cosmetic.svg',
  },
  {
    title: '임플란트',
    desc: '상실된 치아를 자연스럽게 대체합니다. CT 기반 정밀 임플란트 계획. 만 65세 이상 건강보험 적용.',
    slug: 'implants',
    icon: '/images/icons/implant.svg',
  },
  {
    title: '크라운, 브릿지 & 틀니',
    desc: '맞춤 제작 포세린/지르코니아 크라운, 고정식 브릿지, 전체/부분 틀니로 상실된 치아의 기능을 회복합니다.',
    slug: 'prosthodontics',
    icon: '/images/icons/prosthodontics.svg',
  },
  {
    title: '보존/신경 치료',
    desc: '레진 충전, 근관(신경) 치료, 본딩으로 손상된 치아를 수복합니다. Zeiss 수술용 현미경을 활용한 정밀 치료.',
    slug: 'restorative',
    icon: '/images/icons/restorative.svg',
  },
  {
    title: '검진 & 스케일링',
    desc: '디지털 CT를 활용한 종합 구강 검진, 전문 스케일링. 건강보험 연 1회 스케일링 적용.',
    slug: 'checkups',
    icon: '/images/icons/hygiene.svg',
  },
  {
    title: '발치 & 구강 소수술',
    desc: '사랑니(매복치 포함) 발치, 단순/외과적 발치, 구강 내 소수술을 안전하게 진행합니다.',
    slug: 'extractions',
    icon: '/images/icons/extraction.svg',
  },
];
---

<BaseLayout
  title="진료 안내 — 서울 광화문 런던치과"
  description="런던치과의 진료 안내. 심미치과, 임플란트, 미백, 크라운, 신경치료, 검진, 스케일링 등. 영어/한국어 이중언어 진료. 건강보험 적용."
  lang={lang}
  canonicalPath="/ko/services"
>
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-4 font-heading">
        진료 안내
      </h1>
      <p class="text-lg text-slate-600 mb-12 max-w-2xl">
        런던치과의 모든 상담과 치료는 박지연 원장이 <strong>영어 또는 한국어</strong>로 직접 진행합니다. 건강보험 적용 항목은 보험 진료가 가능합니다.
      </p>

      <div class="space-y-6">
        {services.map((service) => (
          <a
            href={`/ko/procedures/${service.slug}`}
            class="group flex gap-5 p-6 bg-slate-50 rounded-xl hover:bg-brand-50 hover:shadow-md transition-all duration-300 border border-slate-100 hover:border-brand-200"
          >
            <div class="w-14 h-14 rounded-xl bg-white flex items-center justify-center flex-shrink-0 shadow-sm group-hover:bg-brand-100 transition-colors">
              <img src={service.icon} alt="" class="w-8 h-8 opacity-80 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <div class="flex-grow">
              <h2 class="text-lg font-semibold text-slate-900 font-heading mb-1 group-hover:text-brand-700 transition-colors">
                {service.title}
              </h2>
              <p class="text-sm text-slate-600 leading-relaxed">{service.desc}</p>
            </div>
            <svg class="w-5 h-5 text-slate-400 group-hover:text-brand-600 flex-shrink-0 mt-1 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-14 text-center bg-brand-50 rounded-2xl p-8">
        <h3 class="text-xl font-bold text-slate-900 font-heading mb-2">예약하시겠습니까?</h3>
        <p class="text-sm text-slate-600 mb-6">온라인 예약 또는 전화로 문의해 주세요.</p>
        <div class="flex justify-center gap-3">
          <a
            href={clinic.links.naverBooking}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 py-3 px-6 bg-[#03c75a] hover:bg-[#02b350] text-white font-bold rounded-xl shadow-lg text-sm transition-all"
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M16.273 12.845L7.376 0H0v24h7.727V11.155L16.624 24H24V0h-7.727v12.845z"/></svg>
            네이버 예약
          </a>
          <a
            href={`tel:${clinic.phone.tel}`}
            class="flex items-center gap-2 py-3 px-6 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-xl shadow-lg text-sm transition-all"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            02-732-1917
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
