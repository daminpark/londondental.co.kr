---
// Root page - redirects to /en/ or /ko/ based on browser language
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>London Dental Clinic | 런던치과</title>
    <meta http-equiv="refresh" content="0;url=/en/" />
    <link rel="alternate" hreflang="en" href="https://www.londondental.co.kr/en/" />
    <link rel="alternate" hreflang="ko" href="https://www.londondental.co.kr/ko/" />
    <link rel="alternate" hreflang="x-default" href="https://www.londondental.co.kr/en/" />
    <script is:inline>
      const lang = (navigator.language || '').toLowerCase();
      if (lang.startsWith('ko')) {
        window.location.replace('/ko/');
      } else {
        window.location.replace('/en/');
      }
    </script>
  </head>
  <body>
    <p>Redirecting... <a href="/en/">English</a> | <a href="/ko/">한국어</a></p>
  </body>
</html>
