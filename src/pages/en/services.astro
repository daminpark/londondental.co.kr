---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { clinic } from '../../data/clinic';

const lang = 'en' as const;

const services = [
  {
    title: 'Cosmetic Dentistry & Whitening',
    desc: 'Professional teeth whitening, porcelain and composite veneers, cosmetic bonding, and smile makeovers to brighten and transform your smile.',
    slug: 'cosmetic',
    icon: '/images/icons/cosmetic.svg',
  },
  {
    title: 'Dental Implants',
    desc: 'Natural-feeling replacements for missing teeth. CT-guided implant planning for precision. Korean health insurance covers implants for patients aged 65+.',
    slug: 'implants',
    icon: '/images/icons/implant.svg',
  },
  {
    title: 'Crowns, Bridges & Dentures',
    desc: 'Custom-made porcelain and zirconia crowns, fixed bridges, and full or partial dentures to restore missing teeth and full function.',
    slug: 'prosthodontics',
    icon: '/images/icons/prosthodontics.svg',
  },
  {
    title: 'Restorative Dentistry',
    desc: 'Composite resin fillings, root canal (endodontic) treatment, and dental bonding to repair decay and damage. Performed under Zeiss surgical microscope for precision.',
    slug: 'restorative',
    icon: '/images/icons/restorative.svg',
  },
  {
    title: 'Checkups & Cleaning',
    desc: 'Comprehensive oral exams with digital CT X-rays, professional scaling and cleaning. Korean health insurance covers scaling once per year.',
    slug: 'checkups',
    icon: '/images/icons/hygiene.svg',
  },
  {
    title: 'Extractions & Oral Surgery',
    desc: 'Safe removal of wisdom teeth (including impacted teeth), simple and surgical extractions, and minor oral surgical procedures.',
    slug: 'extractions',
    icon: '/images/icons/extraction.svg',
  },
];
---

<BaseLayout
  title="Dental Services — English-Speaking Dentist in Seoul"
  description="Full range of dental services in English at London Dental Clinic, Seoul. Cosmetic dentistry, implants, whitening, crowns, root canals, checkups & more. Korean health insurance accepted."
  lang={lang}
  canonicalPath="/en/services"
>
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-4 font-heading">
        Our Dental Services
      </h1>
      <p class="text-lg text-slate-600 mb-12 max-w-2xl">
        All consultations and treatments at London Dental Clinic are conducted in <strong>English or Korean</strong> by Dr. Fiona Park. We accept Korean National Health Insurance for covered procedures.
      </p>

      <div class="space-y-6">
        {services.map((service) => (
          <a
            href={`/en/procedures/${service.slug}`}
            class="group flex gap-5 p-6 bg-slate-50 rounded-xl hover:bg-brand-50 hover:shadow-md transition-all duration-300 border border-slate-100 hover:border-brand-200"
          >
            <div class="w-14 h-14 rounded-xl bg-white flex items-center justify-center flex-shrink-0 shadow-sm group-hover:bg-brand-100 transition-colors">
              <img src={service.icon} alt="" class="w-8 h-8 opacity-80 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <div class="flex-grow">
              <h2 class="text-lg font-semibold text-slate-900 font-heading mb-1 group-hover:text-brand-700 transition-colors">
                {service.title}
              </h2>
              <p class="text-sm text-slate-600 leading-relaxed">{service.desc}</p>
            </div>
            <svg class="w-5 h-5 text-slate-400 group-hover:text-brand-600 flex-shrink-0 mt-1 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-14 text-center bg-brand-50 rounded-2xl p-8">
        <h3 class="text-xl font-bold text-slate-900 font-heading mb-2">Ready to book?</h3>
        <p class="text-sm text-slate-600 mb-6">Schedule your appointment online or call us directly.</p>
        <div class="flex justify-center gap-3">
          <a
            href={clinic.links.naverBooking}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 py-3 px-6 bg-[#03c75a] hover:bg-[#02b350] text-white font-bold rounded-xl shadow-lg text-sm transition-all"
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M16.273 12.845L7.376 0H0v24h7.727V11.155L16.624 24H24V0h-7.727v12.845z"/></svg>
            Book on Naver
          </a>
          <a
            href={`tel:${clinic.phone.tel}`}
            class="flex items-center gap-2 py-3 px-6 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-xl shadow-lg text-sm transition-all"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            +82-2-732-1917
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
