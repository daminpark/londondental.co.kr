---
import { type Lang } from '../../i18n/languages';
import { clinic } from '../../data/clinic';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const phone = lang === 'ko' ? clinic.phone.domestic : clinic.phone.international;
---

<section class="py-20 md:py-28 bg-brand-600">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl lg:text-4xl font-bold text-white font-heading mb-4">
      {lang === 'ko'
        ? '편안한 진료, 지금 예약하세요.'
        : 'Ready for dental care you can understand?'}
    </h2>
    <p class="text-white/80 mb-10 text-lg">
      {lang === 'ko'
        ? '영어와 한국어로 편안하게 상담받으세요. 건강보험 적용됩니다.'
        : 'Book your appointment in English or Korean. Health insurance accepted.'}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={clinic.links.naverBooking}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 py-4 px-10 bg-white text-slate-900 font-bold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
      >
        <span class="text-[#03c75a] text-xl font-black">N</span>
        {lang === 'ko' ? '네이버 예약' : 'Book on Naver'}
      </a>

      <a
        href={`tel:${clinic.phone.tel}`}
        class="flex items-center justify-center gap-2 py-4 px-10 bg-white text-brand-700 font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
        </svg>
        {phone}
      </a>
    </div>

    <p class="text-white/70 text-sm mt-6">
      {lang === 'ko' ? '평일 09:30-18:30 · 토요일 09:30-14:00' : 'Weekdays 09:30-18:30 · Saturday 09:30-14:00'}
    </p>
  </div>
</section>
