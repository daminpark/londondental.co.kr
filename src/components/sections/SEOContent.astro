---
import { type Lang } from '../../i18n/languages';
import { clinic } from '../../data/clinic';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{lang === 'en' ? (
  <section class="py-16 md:py-20 bg-white border-t border-slate-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 font-heading mb-6">
        English Speaking Dentist in Seoul for Expats & Visitors
      </h2>
      <div class="prose prose-slate max-w-none text-slate-600 leading-relaxed space-y-4">
        <p>
          Finding a <strong>English speaking dentist in Seoul</strong> can be challenging. At London Dental Clinic, Dr. Fiona Park provides fully bilingual dental care in <strong>English and Korean</strong>. Whether you're an expat living in Seoul, a tourist needing emergency dental care, or a Korean patient who prefers English communication, we welcome you.
        </p>
        <p>
          Dr. Park trained at <strong>Barts and The London School of Medicine and Dentistry</strong> (Queen Mary University of London) and <strong>Seoul National University</strong>. She holds dental licenses in both the <strong>UK and South Korea</strong>, with over 15 years of clinical experience across London and Seoul. This dual background means you get world-class care with none of the language barriers.
        </p>
        <p>
          Our clinic is conveniently located in <strong>Jongno-gu, central Seoul</strong> — a 5-minute walk from <strong>Gwanghwamun Station</strong> (Line 5), Jonggak Station (Line 1), and Gyeongbokgung Station (Line 3). We offer a full range of services including <strong>dental implants</strong>, <strong>cosmetic dentistry</strong>, teeth whitening, crowns and bridges, root canal treatment, wisdom tooth extraction, and routine checkups with scaling.
        </p>
        <p>
          We accept <strong>Korean National Health Insurance</strong> for covered procedures and provide detailed English documentation for <strong>international insurance</strong> reimbursement. Dental care in Seoul costs significantly less than in the US, UK, or Australia — without compromising on quality.
        </p>
        <p>
          Book your appointment via <a href={clinic.links.naverBooking} target="_blank" rel="noopener noreferrer" class="text-brand-600 font-semibold hover:underline">Naver Booking</a> or call <a href={`tel:${clinic.phone.tel}`} class="text-brand-600 font-semibold hover:underline">{clinic.phone.international}</a>.
        </p>
      </div>
    </div>
  </section>
) : (
  <section class="py-16 md:py-20 bg-white border-t border-slate-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 font-heading mb-6">
        서울 광화문 영어 진료 치과 — 런던치과
      </h2>
      <div class="prose prose-slate max-w-none text-slate-600 leading-relaxed space-y-4">
        <p>
          <strong>서울에서 영어 가능한 치과</strong>를 찾고 계신가요? 런던치과의 박지연 원장은 영국 런던대학교(Barts and The London)와 서울대학교 치의학대학원을 졸업하고 <strong>영국과 한국 양국의 치과의사 면허</strong>를 보유한 이중언어 치과의사입니다.
        </p>
        <p>
          서울에 거주하는 외국인, 여행 중 치과 치료가 필요한 관광객, 영어 소통을 선호하는 한국인 환자 모두 환영합니다. 15년 이상의 임상 경험을 바탕으로 <strong>과잉 진료 없이</strong> 꼼꼼하고 정직한 치료를 약속드립니다.
        </p>
        <p>
          런던치과는 <strong>서울 종로구 광화문</strong>에 위치해 있으며, 광화문역(5호선), 종각역(1호선), 경복궁역(3호선)에서 도보 5분 거리입니다. <strong>임플란트</strong>, <strong>심미치과</strong>(미백, 라미네이트), 크라운/브릿지, 틀니, 충치 치료, 신경 치료, 사랑니 발치, 검진, 스케일링 등 종합적인 치과 진료를 제공합니다.
        </p>
        <p>
          <strong>국민건강보험</strong>이 적용되는 항목은 보험 진료가 가능하며, 외국인 환자를 위한 영문 진료 내역서도 발급해 드립니다.
        </p>
        <p>
          <a href={clinic.links.naverBooking} target="_blank" rel="noopener noreferrer" class="text-brand-600 font-semibold hover:underline">네이버 예약</a> 또는 전화 <a href={`tel:${clinic.phone.tel}`} class="text-brand-600 font-semibold hover:underline">{clinic.phone.domestic}</a>로 예약해 주세요.
        </p>
      </div>
    </div>
  </section>
)}
