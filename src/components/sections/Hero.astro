---
import { Image } from 'astro:assets';
import { type Lang } from '../../i18n/languages';
import { useTranslations } from '../../i18n/utils';
import { clinic } from '../../data/clinic';
import drFiona from '../../assets/dr-fiona-hero.jpg';
import drFionaMobile from '../../assets/dr-fiona-mobile.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const phone = lang === 'ko' ? clinic.phone.domestic : clinic.phone.international;
---

<!-- ===== DESKTOP HERO: full-background with text overlay ===== -->
<section id="home" class="relative overflow-hidden hidden md:block" style="background-color: #c6ced1;">
  <!-- Fiona photo: full-width composited image, Fiona positioned in right half -->
  <div class="absolute inset-0">
    <Image
      src={drFiona}
      alt=""
      widths={[1200, 1800, 2400]}
      sizes="100vw"
      format="webp"
      quality={92}
      loading="eager"
      class="w-full h-full object-cover"
      style="object-position: 72% bottom;"
    />
  </div>

  <!-- Left side: white wash for text readability, stops before Fiona -->
  <div class="absolute inset-0 bg-gradient-to-r from-white via-white/80 via-30% to-transparent to-55%"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="min-h-[90vh] pt-20 pb-20 flex items-center">
      <div class="max-w-xl">
        <!-- University logos -->
        <div class="flex items-center gap-3 mb-8">
          <div class="bg-white/80 backdrop-blur-sm rounded-lg px-3 py-2 flex items-center shadow-sm">
            <img src="/images/emblems/seoul-national-university.svg" alt="Seoul National University" class="h-7 w-auto" />
          </div>
          <div class="bg-white/80 backdrop-blur-sm rounded-lg px-3 py-2 flex items-center shadow-sm">
            <img src="/images/emblems/barts-london.svg" alt="Barts & The London" class="h-7 w-auto" />
          </div>
          <span class="text-xs text-slate-600 font-medium border-l border-slate-400 pl-3">
            {lang === 'ko' ? '영국/한국 복수 면허' : 'UK & KR Licensed'}
          </span>
        </div>

        <h1 class="text-6xl xl:text-[4.25rem] font-bold font-heading leading-[1.08] mb-6 tracking-tight text-slate-900">
          {lang === 'ko' ? (
            <Fragment>
              꼼꼼하게, 정직하게,<br/>
              <span class="text-brand-600">제대로 하는 치과.</span>
            </Fragment>
          ) : (
            <Fragment>
              Your English-speaking<br/>
              <span class="text-brand-600">dentist in Seoul.</span>
            </Fragment>
          )}
        </h1>

        <p class="text-lg text-slate-600 mb-10 max-w-md leading-relaxed">
          {lang === 'ko'
            ? '영국에서 수련받은 박지연 원장이 직접 진료합니다. 과잉진료 없이, 시간을 들여 꼼꼼하게.'
            : "Dr. Fiona Park sees every patient herself. UK-trained, fluent in English and Korean, and never in a rush. A small clinic that does things properly."}
        </p>

        <div class="flex gap-3">
          <a
            href={clinic.links.naverBooking}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2.5 py-4 px-8 bg-[#03c75a] hover:bg-[#02b350] text-white font-bold rounded-xl shadow-lg shadow-[#03c75a]/20 transition-all duration-300 text-base btn-press"
          >
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d="M16.273 12.845L7.376 0H0v24h7.727V11.155L16.624 24H24V0h-7.727v12.845z"/></svg>
            {lang === 'ko' ? '네이버 예약' : 'Book on Naver'}
          </a>
          <a
            href={`tel:${clinic.phone.tel}`}
            class="flex items-center justify-center gap-2 py-4 px-8 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-xl shadow-lg shadow-brand-500/20 transition-all duration-300 btn-press"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            {phone}
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-3 mt-8 text-xs text-slate-500">
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            5.0 Naver
          </span>
          <span class="w-1 h-1 rounded-full bg-slate-300"></span>
          <span>{lang === 'ko' ? '건강보험 적용' : 'Insurance accepted'}</span>
          <span class="w-1 h-1 rounded-full bg-slate-300"></span>
          <span>{lang === 'ko' ? '광화문역 5분' : '5 min from Gwanghwamun Stn'}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== MOBILE HERO: photo top half, text bottom half, blended ===== -->
<section id="home-mobile" class="relative md:hidden bg-white">
  <!-- Photo: taller container so the photo's own background provides breathing room above -->
  <div class="relative overflow-hidden" style="height: 50vh; margin-top: -1px;">
    <Image
      src={drFionaMobile}
      alt={lang === 'ko' ? '박지연 원장' : 'Dr. Fiona Park'}
      widths={[400, 560, 720]}
      sizes="100vw"
      format="webp"
      quality={90}
      loading="eager"
      class="w-full h-full object-cover object-[center_20%]"
    />
    <!-- Aggressive fade to white at bottom -->
    <div class="absolute bottom-0 left-0 right-0 h-44" style="background: linear-gradient(to top, white 0%, rgba(255,255,255,0.85) 30%, rgba(255,255,255,0.4) 60%, transparent 100%);"></div>
  </div>

  <!-- Text: sits right below, slight negative margin to overlap -->
  <div class="relative bg-white px-5 pb-8 pt-2 -mt-4">
    <!-- Logos -->
    <div class="flex items-center gap-2 mb-4">
      <div class="bg-slate-50 rounded-lg px-2.5 py-1.5 flex items-center">
        <img src="/images/emblems/seoul-national-university.svg" alt="SNU" class="h-6 w-auto" />
      </div>
      <div class="bg-slate-50 rounded-lg px-2.5 py-1.5 flex items-center">
        <img src="/images/emblems/barts-london.svg" alt="Barts" class="h-6 w-auto" />
      </div>
      <span class="text-[10px] text-slate-500 font-medium border-l border-slate-200 pl-2">
        {lang === 'ko' ? '영국/한국 면허' : 'UK & KR Licensed'}
      </span>
    </div>

    <h1 class="text-[2rem] sm:text-4xl font-bold font-heading leading-[1.1] mb-3 tracking-tight text-slate-900">
      {lang === 'ko' ? (
        <Fragment>
          꼼꼼하게, 정직하게, <span class="text-brand-600">제대로 하는 치과.</span>
        </Fragment>
      ) : (
        <Fragment>
          Your English-speaking <span class="text-brand-600">dentist in Seoul.</span>
        </Fragment>
      )}
    </h1>

    <p class="text-sm text-slate-600 mb-6 leading-relaxed">
      {lang === 'ko'
        ? '영국에서 수련받은 박지연 원장이 직접 진료합니다. 과잉진료 없이, 시간을 들여 꼼꼼하게.'
        : "UK-trained Dr. Fiona Park. Fluent English & Korean. Never in a rush."}
    </p>

    <div class="flex gap-3">
      <a
        href={clinic.links.naverBooking}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 flex items-center justify-center gap-2 py-3.5 bg-[#03c75a] hover:bg-[#02b350] text-white font-bold rounded-xl shadow-lg text-sm"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M16.273 12.845L7.376 0H0v24h7.727V11.155L16.624 24H24V0h-7.727v12.845z"/></svg>
        {lang === 'ko' ? '네이버 예약' : 'Book on Naver'}
      </a>
      <a
        href={`tel:${clinic.phone.tel}`}
        class="flex-1 flex items-center justify-center gap-2 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-xl shadow-lg text-sm"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
        </svg>
        {phone}
      </a>
    </div>

    <div class="flex flex-wrap items-center gap-2 mt-5 text-[10px] text-slate-400">
      <span class="flex items-center gap-1">
        <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
        5.0 Naver
      </span>
      <span class="w-1 h-1 rounded-full bg-slate-300"></span>
      <span>{lang === 'ko' ? '건강보험 적용' : 'Insurance accepted'}</span>
      <span class="w-1 h-1 rounded-full bg-slate-300"></span>
      <span>{lang === 'ko' ? '광화문역 5분' : '5 min from Gwanghwamun Stn'}</span>
    </div>
  </div>
</section>

<!-- Stats -->
<div class="bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-slate-100">
      {[
        { value: '15+', label: lang === 'ko' ? '년 경력' : 'Years Experience' },
        { value: lang === 'ko' ? '영국/한국' : 'UK & KR', label: lang === 'ko' ? '복수 면허' : 'Dual Licensed' },
        { value: lang === 'ko' ? '영어/한국어' : 'EN / KO', label: lang === 'ko' ? '이중언어 진료' : 'Bilingual Care' },
        { value: '5.0 ★', label: lang === 'ko' ? '네이버 리뷰' : 'Naver Reviews' },
      ].map((stat) => (
        <div class="py-5 px-4 text-center">
          <p class="text-xl sm:text-2xl font-bold text-slate-900 font-heading">{stat.value}</p>
          <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</div>
