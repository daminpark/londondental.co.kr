---
import { languages, type Lang } from '../../i18n/languages';
import { getAlternatePath } from '../../i18n/utils';

interface Props {
  lang: Lang;
  currentPath: string;
  variant?: 'header' | 'mobile' | 'footer';
}

const { lang, currentPath, variant = 'header' } = Astro.props;
const alternateLang = lang === 'en' ? 'ko' : 'en';
const alternatePath = getAlternatePath(currentPath);
const alternateLabel = languages[alternateLang].label;
---

{variant === 'header' && (
  <a
    href={alternatePath}
    class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-slate-200 hover:border-brand-400 hover:bg-brand-50 transition-all duration-200 text-sm font-medium text-slate-600 hover:text-brand-700"
    aria-label={`Switch to ${alternateLabel}`}
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
    <span>{alternateLabel}</span>
  </a>
)}

{variant === 'mobile' && (
  <a
    href={alternatePath}
    class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg bg-slate-100 hover:bg-brand-50 text-slate-700 hover:text-brand-700 font-medium transition-colors duration-200"
    aria-label={`Switch to ${alternateLabel}`}
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
    <span>{alternateLabel}</span>
  </a>
)}

{variant === 'footer' && (
  <div class="flex gap-2">
    <a
      href={lang === 'en' ? currentPath : getAlternatePath(currentPath)}
      class:list={[
        'px-3 py-1.5 rounded text-sm transition-colors duration-200',
        lang === 'en' ? 'bg-brand-600 text-white' : 'bg-slate-700/50 text-slate-400 hover:text-brand-400 hover:bg-slate-600/50',
      ]}
    >
      EN
    </a>
    <a
      href={lang === 'ko' ? currentPath : getAlternatePath(currentPath)}
      class:list={[
        'px-3 py-1.5 rounded text-sm transition-colors duration-200',
        lang === 'ko' ? 'bg-brand-600 text-white' : 'bg-slate-700/50 text-slate-400 hover:text-brand-400 hover:bg-slate-600/50',
      ]}
    >
      KO
    </a>
  </div>
)}
